# Copy this file to .env and adjust values for your environment.
# Docker Compose automatically reads .env from repository root.
# Backend local development also loads this file via backend/config.py.

# Reverse proxy / SSL
SSL_ENABLED=false
CERT_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Service ports
VIRTUOSO_PORT=8890

# Backend service URLs
VIRTUOSO_URL=http://virtuoso:8890
LODVIEW_URL=http://lodview:8080

# External/browser URLs
EXTERNAL_VIRTUOSO_URL=http://localhost:8890
EXTERNAL_LODVIEW_URL=http://localhost:8080
EXTERNAL_BACKEND_URL=http://localhost/api
EXTERNAL_FRONTEND_URL=http://localhost

# Graph defaults
GRAPH_BASE_URI=http://localhost/graph
DEFAULT_GRAPH_NAME=default
SPARQL_ENDPOINT=http://localhost:8890/sparql

# Flask settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=production
FLASK_DEBUG=false
MAX_CONTENT_LENGTH=1073741824

# Virtuoso authentication
DBA_PASSWORD=dba
SPARQL_UPDATE=false

# Upload job persistence
APP_DATA_DIR=/tmp/kg-viewer
UPLOAD_JOBS_STORAGE=file
UPLOAD_JOBS_FILE=/tmp/kg-viewer/upload_jobs.json
